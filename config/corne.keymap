#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        plus_minus: plus_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N2 &kp KP_N4 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };
    };
};

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&trans   &kp F    &kp L  &kp V  &kp X    &kp J      &kp P            &lt 4 O  &kp COMMA  &trans                     &kp H      &lt 1 S
&lt 2 R  &lt 3 N  &kp B  &kp Z  &lt 3 I  &lt 2 E    &lt 1 A          &kp C    &kp K      &kp G                      &kp W      &kp M
&trans   &trans   &kp U  &kp Y  &kp DOT  &kp Q      &lt 4 BACKSPACE  &lt 3 T  &lt 5 D    &mt RIGHT_SHIFT BACKSPACE  &kp SPACE  &trans
            >;
        };

        Ring {
            bindings = <
&trans            &trans      &kp RA(NON_US_BACKSLASH)  &kp SLASH  &kp NON_US_BSLH   &kp LS(NON_US_BSLH)    &kp LBKT          &kp SEMI               &kp SQT  &plus_minus               &kp RA(NUMBER_2)  &kp MINUS
&kp RA(NUMBER_3)  &kp LS(N8)  &kp RA(MINUS)             &trans     &kp LS(N9)        &kp RA(E)              &kp SINGLE_QUOTE  &trans                 &trans   &kp RA(NUMBER_3)          &trans            &trans
&trans            &trans      &trans                    &trans     &kp LS(NUMBER_1)  &trans                 &trans            &kp RA(RIGHT_BRACKET)  &trans   &mt LEFT_SHIFT BACKSPACE  &kp ENTER         &trans
            >;
        };

        Middle {
            bindings = <
&trans  &trans      &trans      &kp RA(M)   &trans         &trans    &kp LS(QUESTION)  &trans  &kp LS(NUMBER_2)  &kp LS(N5)     &kp GRAVE  &kp LS(N7)
&trans  &kp RA(N8)  &kp RA(N7)  &kp RA(N0)  &kp RA(N9)     &trans    &kp RA(Q)         &trans  &trans            &kp LS(GRAVE)  &trans     &trans
&trans  &trans      &trans      &trans      &kp LS(MINUS)  &trans    &trans            &trans  &trans            &trans         &kp TAB    &trans
            >;
        };

        Index {
            bindings = <
&kp SLASH   &kp N6  &kp N7  &kp N8  &kp RIGHT_BRACKET  &kp KP_NUMLOCK    &kp LS(NUMBER_6)  &trans     &trans         &trans        &kp N2     &kp N1
&kp N0      &kp N5  &kp N4  &trans  &trans             &sk LEFT_GUI      &sk LEFT_ALT      &sk RCTRL  &kp DEL        &kp NUMBER_3  &kp COMMA  &kp N9
&kp PERIOD  &trans  &trans  &trans  &trans             &trans            &kp DELETE        &kp ENTER  &kp BACKSPACE  &trans        &trans     &trans
            >;
        };

        arrows {
            bindings = <
&kp LS(N7)  &kp SLASH  &kp UP   &kp RIGHT_BRACKET  &kp LS(RIGHT_BRACKET)  &trans    &trans  &trans  &trans  &trans            &kp HOME  &kp LEFT
&kp DOWN    &kp RIGHT  &kp END  &trans             &trans                 &trans    &trans  &trans  &to 0   &kp LS(NUMBER_0)  &trans    &trans
&to 7       &trans     &trans   &trans             &trans                 &trans    &trans  &trans  &trans  &trans            &trans    &trans
            >;
        };

        shortcuts {
            bindings = <
&kp ESCAPE  &kp LA(LC(DELETE))  &kp LG(E)      &kp LC(LS(ESCAPE))  &kp PRINTSCREEN  &trans       &trans  &trans  &trans     &trans        &kp LC(S)     &kp LC(X)
&kp LC(C)   &kp LC(V)           &kp LA(ENTER)  &trans              &trans           &trans       &trans  &trans  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans      &trans              &trans         &kp RIGHT_GUI       &kp RIGHT_ALT    &kp RCTRL    &trans  &trans  &trans     &trans        &trans        &trans
            >;
        };

        f-keys {
            bindings = <
&kp F1   &kp F2  &kp F3   &kp F4  &kp F5  &trans    &trans  &trans  &trans   &trans   &kp F6   &kp F7
&kp F8   &kp F9  &kp F10  &trans  &trans  &trans    &trans  &trans  &kp F11  &kp F12  &kp F13  &kp F14
&kp F15  &trans  &trans   &trans  &trans  &trans    &trans  &trans  &trans   &trans   &trans   &trans
            >;
        };

        GamingBase {
            bindings = <
&kp TAB  &kp Q  &kp W  &kp E   &kp R   &kp T     &kp Y           &kp F7  &kp F8     &kp F9  &kp LSHFT  &kp A
&kp S    &kp D  &kp F  &kp G   &kp H   &kp F4    &kp F5          &kp F6  &kp LCTRL  &kp Z   &kp X      &kp C
&kp V    &kp N  &kp M  &kp F1  &kp F2  &kp F3    &lt 4 LEFT_ALT  &kp T   &lt 3 B    &kp I   &kp J      &kp Z
            >;
        };
    };
};
